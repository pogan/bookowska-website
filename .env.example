# Skopiuj do .env i uzupełnij. .env NIE trafia do repozytorium (.gitignore).

# --- Serwer ---
# Port aplikacji za nginx (na VPS "websites" zajęte są 3000-3005).
PORT=3006
# Adres nasłuchu; na produkcji domyślnie 127.0.0.1 (ruch tylko przez nginx).
HOST=
# development lokalnie; na serwerze production (secure cookies, HSTS - wymaga HTTPS za nginx).
NODE_ENV=development
# Bezwzględny adres strony (linki w e-mailach, canonical, sitemap, og:image).
PUBLIC_BASE_URL=http://localhost:3006
# true dopiero po podpięciu docelowej domeny - wcześniej noindex + robots.txt "Disallow: /".
ALLOW_INDEXING=false
# Długi losowy ciąg (min. 32 znaki na produkcji):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Ścieżka do bazy SQLite (domyślnie ./data/bookowska.sqlite).
DB_PATH=

# --- Dostęp do panelu (/admin) przez Google ---
# Konto root - "zaszyty" właściciel serwisu, zawsze ma dostęp.
ROOT_EMAIL=
# Dodatkowi administratorzy (np. Gmail Kariny), rozdzieleni przecinkami.
ADMIN_EMAILS=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI musi być identyczny z GOOGLE_CALLBACK_URL (domyślnie
# PUBLIC_BASE_URL + /auth/google/callback), np. http://localhost:3006/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Poczta (zgłoszenia na warsztaty, potwierdzenia zamówień) ---
# Bez SMTP_HOST e-maile są pomijane (log w konsoli), zgłoszenia i tak trafiają do bazy.
SMTP_HOST=
SMTP_PORT=587
# true dla portu 465 (TLS od razu); dla 587 zostaw false (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Nadawca, np. "Bookowska <pracownia@example.pl>"; domyślnie SMTP_USER.
MAIL_FROM=

# --- Dane kontaktowe pracowni (strona + adresat zgłoszeń i zamówień) ---
CONTACT_EMAIL=
CONTACT_PHONE=
# Opcjonalny adres pracowni; pusty = na stronie tylko "Sopot".
STUDIO_ADDRESS=

# --- Dane sprzedawcy (regulamin, polityka prywatności, potwierdzenia) ---
SELLER_NAME=
SELLER_ADDRESS=
SELLER_NIP=
SELLER_REGON=

# --- Płatności ---
# Na razie tylko "mock" (symulacja bramki). Po wyborze operatora: lib/payments/<operator>.js.
PAYMENT_PROVIDER=mock
