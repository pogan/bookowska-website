# Bookowska — pm2: bookowska-website, port 3006
# /etc/nginx/sites-available/bookowska-website
#
# Staging: bookowska.vamude.com (VPS "websites"). Produkcja: bookowska.shop na VPS
# klientki - ten sam układ; zamień server_name i ścieżki certyfikatu, dodaj
# www.bookowska.shop do bloku przekierowania.
#
# Pierwsze uruchomienie (certyfikatu jeszcze nie ma):
#   1. włącz tylko blok "listen 80" (ACME + przekierowanie), nginx -t, reload
#   2. sudo certbot certonly --webroot -w /var/www/certbot -d bookowska.vamude.com
#   3. dodaj blok 443, nginx -t, reload

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name bookowska.vamude.com;

    ssl_certificate     /etc/letsencrypt/live/bookowska.vamude.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bookowska.vamude.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Formularze są krótkie (Express przyjmuje do 20 kB).
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:3006;
        include snippets/proxy.conf;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name bookowska.vamude.com;

    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
