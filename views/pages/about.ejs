<section class="page-head">
  <div class="container">
    <nav class="crumbs" aria-label="Okruszki"><a href="/">Start</a><span aria-hidden="true">/</span>O mnie</nav>
    <span class="label"><%= site.owner %> · <%= site.role %></span>
    <h1 class="display"><%= f.typo('Poznaj swojego oprawcę') %></h1>
  </div>
</section>

<section class="sheet pt-0">
  <div class="container">
    <div class="row g-5">
      <div class="col-md-5">
        <%- include('../partials/photo', { key: 'karina-profil', sizes: '(min-width: 768px) 40vw, 100vw', ratio: '4x5', fig: '01', caption: site.owner, priority: true }) %>
      </div>
      <div class="col-md-7 col-lg-6 offset-lg-1 prose">
        <p class="lead"><%= f.typo('Cześć! Tu Kara, czyli Bookowska, i jestem oprawcą, czyli introligatorem. Lubię książki i papier, więc chyba całkiem nieźle trafiłam z wyborem ścieżki zawodowej :)') %></p>
        <p><%= f.typo('Oficjalnie introligatorstwem zajmuję się od 2016 roku, kiedy to zdobyłam tytuł zawodowy w tej dziedzinie. Od tego czasu złożyłam setki książek, przeprowadziłam dziesiątki warsztatów, prelekcji, pokazów i… ciągle mi mało!') %></p>
        <p><%= f.typo('Prowadzę małą pracownię w Sopocie — to tam można mnie najczęściej spotkać, wpaść na herbatę i obgadać pomysł.') %></p>
        <p><%= f.typo('Najbardziej lubię pracować nad nietypowymi projektami i z chęcią pomogę Ci przenieść Twoją wizję z komputera do świata materialnego.') %></p>
        <p><%= f.typo('Cieszę się, że tu trafiłeś, i mam nadzieję, że do zobaczenia!') %></p>
        <dl class="spec">
          <div><dt>W zawodzie od</dt><dd><%= site.since %></dd></div>
          <div><dt>Pracownia</dt><dd><%= site.city %></dd></div>
          <div><dt>Ulubione</dt><dd>nietypowe projekty</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<section class="sheet" id="na-zamowienie">
  <div class="container">
    <%- include('../partials/sheet-head', { no: '01', title: 'Na zamówienie' }) %>
    <div class="row g-5 align-items-center">
      <div class="col-lg-6 order-lg-2">
        <%- include('../partials/photo', { key: 'nozyczki', sizes: '(min-width: 992px) 50vw, 100vw', ratio: '3x2', fig: '02', caption: 'Praca w pracowni' }) %>
      </div>
      <div class="col-lg-6 order-lg-1">
        <h2 class="h-section"><%= f.typo('Oprawię Twój projekt — od pojedynczego egzemplarza.') %></h2>
        <p><%= f.typo('Książka autorska, portfolio, album, notes z Twoim papierem albo pudło na wyjątkowy przedmiot. Napisz, co masz w głowie (albo w komputerze) — dobierzemy technikę, materiały i format.') %></p>
        <div class="actions mt-4">
          <% if (contact.email) { %>
            <a class="btn btn-ink" href="mailto:<%= contact.email %>?subject=<%= encodeURIComponent('Zamówienie indywidualne') %>">Napisz do mnie</a>
          <% } else { %>
            <a class="btn btn-ink" href="/kontakt">Napisz do mnie</a>
          <% } %>
          <a class="btn btn-line" href="/warsztaty">Warsztaty</a>
        </div>
      </div>
    </div>
  </div>
</section>

