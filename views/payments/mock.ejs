<section class="sheet grid-paper rule-bottom">
  <div class="container">
    <div class="gateway">
      <span class="label">Bramka płatności · symulacja</span>
      <h1 class="h-section mb-1">Płatność za zamówienie <%= order.number %></h1>
      <p class="text-muted-ink small mb-0">Odbiorca: <%= seller.name || site.legalBrand %></p>
      <p class="amount"><%= f.money(order.total) %></p>

      <p class="small"><%= f.typo('To nie jest prawdziwa płatność. Docelowo w tym miejscu pojawi się bramka operatora wybranego przez pracownię. Wybierz wynik, który chcesz zasymulować:') %></p>

      <div class="d-grid gap-2 mt-4">
        <form method="post" action="/platnosc/mock/<%= order.payment_ref %>">
          <input type="hidden" name="result" value="paid">
          <button class="btn btn-ink w-100" type="submit"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-check-lg"></use></svg>Płatność udana</button>
        </form>
        <form method="post" action="/platnosc/mock/<%= order.payment_ref %>">
          <input type="hidden" name="result" value="failed">
          <button class="btn btn-line w-100" type="submit">Płatność odrzucona</button>
        </form>
        <form method="post" action="/platnosc/mock/<%= order.payment_ref %>">
          <input type="hidden" name="result" value="cancelled">
          <button class="btn btn-line w-100" type="submit"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#i-x-lg"></use></svg>Anuluj i wróć</button>
        </form>
      </div>
    </div>
  </div>
</section>
